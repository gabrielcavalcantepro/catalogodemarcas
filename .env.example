# Produção/staging: Supabase. Copie as connection strings direto do painel
# da Supabase (Project Settings > Database) — "Copy connection string" já
# aplica URL-encoding em senhas com caracteres especiais.
#
# Pooled via Supavisor (porta 6543, ?pgbouncer=true) — usada pelo app em
# runtime (lib/db.ts).
DATABASE_URL="postgresql://postgres:senha@aws-0-regiao.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direta (porta 5432, sem pooling) — usada só pelo CLI do Prisma pra rodar
# migration (prisma.config.ts). Nunca usada pelo app em runtime.
DIRECT_URL="postgresql://postgres:senha@db.<projeto>.supabase.co:5432/postgres"

# Dev local sem Supabase: comente as duas linhas acima e descomente esta
# (Postgres local, ver docker-compose.yml).
# DATABASE_URL="postgresql://xperformance:xperformance@localhost:5434/xperformance"

# Supabase Storage — bucket "product-photos" (já precisa existir, ver
# lib/storage.ts). SUPABASE_SERVICE_ROLE_KEY bypassa RLS do bucket — nunca
# usar prefixo NEXT_PUBLIC_ nem importar fora de código server-side.
SUPABASE_URL="https://<projeto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="troque-esta-chave"

# Senha única compartilhada da equipe para acessar /admin
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar os cookies de sessão (criadora e admin).
# Gere um valor aleatório forte, ex.: openssl rand -base64 32
SESSION_SECRET="troque-este-segredo"
